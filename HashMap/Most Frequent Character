class Solution {
    public static char getMaxOccuringChar(String s) {
        HashMap<Character, Integer> map = new HashMap<>();

        // Step 1: Count frequencies
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (map.containsKey(ch)) {
                int freq = map.get(ch);
                map.put(ch, freq + 1);
            } else {
                map.put(ch, 1);
            }
        }

        // Step 2: Find the maximum frequency
        int maxFreq = 0;
        for (char ch : map.keySet()) {
            int freq = map.get(ch);
            if (freq > maxFreq) {
                maxFreq = freq;
            }
        }

        // Step 3: Find the lexicographically smallest character with max frequency
        char ans = 'z';
        for (char ch : map.keySet()) {
            int freq = map.get(ch);
            if (freq == maxFreq && ch < ans) {
                ans = ch;
            }
        }

        return ans;
    }
}
