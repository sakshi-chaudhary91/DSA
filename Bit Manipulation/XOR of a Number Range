class Solution {
    private static int findXOR(int n) {
        int rem = n % 4;
        if (rem == 1) return 1;
        if (rem == 2) return n + 1;
        if (rem == 3) return 0;
        return n; // rem == 0
    }

    public static int findXOR(int l, int r) {
        return findXOR(l - 1) ^ findXOR(r);
    }
}
