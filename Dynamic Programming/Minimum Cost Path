class Solution {
    static class Cell implements Comparable<Cell> {
        int r, c, cost;
        Cell(int r, int c, int cost) {
            this.r = r;
            this.c = c;
            this.cost = cost;
        }
        @Override
        public int compareTo(Cell other) {
            return Integer.compare(this.cost, other.cost);
        }
    }

    public int minimumCostPath(int[][] grid) {
        int n = grid.length;
        int[][] dist = new int[n][n];
        for (int[] row : dist) {
            Arrays.fill(row, Integer.MAX_VALUE);
        }

        
        PriorityQueue<Cell> pq = new PriorityQueue<>();
        dist[0][0] = grid[0][0];
        pq.add(new Cell(0, 0, grid[0][0]));

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        while (!pq.isEmpty()) {
            Cell curr = pq.poll();
            int r = curr.r;
            int c = curr.c;
            int currentCost = curr.cost;
            if (r == n - 1 && c == n - 1) {
                return currentCost;
            }

            if (currentCost > dist[r][c]) continue;
            for (int i = 0; i < 4; i++) {
                int nr = r + dr[i];
                int nc = c + dc[i];
                if (nr >= 0 && nr < n && nc >= 0 && nc < n) {
                    // Agar koi sasta path milta hai toh update karo
                    if (dist[r][c] + grid[nr][nc] < dist[nr][nc]) {
                        dist[nr][nc] = dist[r][c] + grid[nr][nc];
                        pq.add(new Cell(nr, nc, dist[nr][nc]));
                    }
                }
            }
        }

        return dist[n - 1][n - 1];
    }
}
