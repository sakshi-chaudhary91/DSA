class Solution {
    public int countIslands(char[][] grid) {
        if (grid == null || grid.length == 0) return 0;

        int n = grid.length;
        int m = grid[0].length;
        boolean[][] visited = new boolean[n][m];
        int count = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (grid[i][j] == 'L' && !visited[i][j]) {
                    count++;
                    bfs(i, j, grid, visited, n, m);
                }
            }
        }
        return count;
    }

    private void bfs(int r, int c, char[][] grid, boolean[][] visited, int n, int m) {
        visited[r][c] = true;
        Queue<int[]> q = new LinkedList<>();
        q.add(new int[]{r, c});

        int[] dr = {-1, -1, -1, 0, 0, 1, 1, 1};
        int[] dc = {-1, 0, 1, -1, 1, -1, 0, 1};

        while (!q.isEmpty()) {
            int[] curr = q.poll();
            int currR = curr[0];
            int currC = curr[1];

            for (int i = 0; i < 8; i++) {
                int newR = currR + dr[i];
                int newC = currC + dc[i];

                if (newR >= 0 && newR < n && newC >= 0 && newC < m) {
                    if (grid[newR][newC] == 'L' && !visited[newR][newC]) {
                        visited[newR][newC] = true;
                        q.add(new int[]{newR, newC});
                    }
                }
            }
        }
    }
}
