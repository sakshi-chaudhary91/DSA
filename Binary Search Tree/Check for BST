class Solution {
    private long prev = Long.MIN_VALUE;

    boolean isBST(Node root) {
        if (root == null) {
            return true;
        }
        if (!isBST(root.left)) {
            return false;
        }

        if (root.data <= prev) {
            return false;
        }
        prev = root.data;

        return isBST(root.right);
    }
}
