class Solution {
    private int maxSum = 0;

    private static class NodeInfo {
        boolean isBST;
        int min;
        int max;
        int sum;

        NodeInfo(boolean isBST, int min, int max, int sum) {
            this.isBST = isBST;
            this.min = min;
            this.max = max;
            this.sum = sum;
        }
    }

    public int maxSumBST(TreeNode root) {
        traverse(root);
        return maxSum; 
    }

    private NodeInfo traverse(TreeNode root) {
        if (root == null) {
            return new NodeInfo(true, Integer.MAX_VALUE, Integer.MIN_VALUE, 0);
        }
        NodeInfo left = traverse(root.left);
        NodeInfo right = traverse(root.right);
        if (left.isBST && right.isBST && left.max < root.val && root.val < right.min) {
            int currentSum = left.sum + right.sum + root.val;
            maxSum = Math.max(maxSum, currentSum);
            int minVal = Math.min(root.val, left.min);
            int maxVal = Math.max(root.val, right.max);
            return new NodeInfo(true, minVal, maxVal, currentSum);
        }
        return new NodeInfo(false, 0, 0, 0);
    }
}
