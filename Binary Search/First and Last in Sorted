class Solution {
    public ArrayList<Integer> find(int arr[], int x) {
        ArrayList<Integer> result = new ArrayList<>();
        result.add(findPosition(arr, x, true));  
        result.add(findPosition(arr, x, false)); 

        return result;
    }

    private int findPosition(int[] arr, int target, boolean isFirst) {
        int start = 0;
        int end = arr.length - 1; 
        int ans = -1;

        while (start <= end) {
            int mid = start + (end - start) / 2;

            if (arr[mid] > target) {
                end = mid - 1;
            } else if (arr[mid] < target) {
                start = mid + 1;
            } else {
                ans = mid;
                if (isFirst) {
                    end = mid - 1; 
                } else {
                    start = mid + 1; 
                }
            }
        }
        return ans;
    }
}
