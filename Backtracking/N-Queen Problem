class Solution {
    public ArrayList<ArrayList<Integer>> nQueen(int n) {
        ArrayList<ArrayList<Integer>> result = new ArrayList<>();
        ArrayList<Integer> board = new ArrayList<>();

        
        boolean[] cols = new boolean[n + 1];
        boolean[] leftDiagonals = new boolean[2 * n + 1];  // row - col + n
        boolean[] rightDiagonals = new boolean[2 * n + 1]; // row + col

        solve(1, n, board, result, cols, leftDiagonals, rightDiagonals);
        return result;
    }

    private void solve(int row, int n, ArrayList<Integer> board, 
                       ArrayList<ArrayList<Integer>> result,
                       boolean[] cols, boolean[] leftDiagonals, boolean[] rightDiagonals) {
       
        if (row > n) {
            result.add(new ArrayList<>(board));
            return;
        }

        
        for (int col = 1; col <= n; col++) {
            int leftDiagIdx = row - col + n;
            int rightDiagIdx = row + col;

            
            if (!cols[col] && !leftDiagonals[leftDiagIdx] && !rightDiagonals[rightDiagIdx]) {
                
                board.add(col);
                cols[col] = true;
                leftDiagonals[leftDiagIdx] = true;
                rightDiagonals[rightDiagIdx] = true;

               
                solve(row + 1, n, board, result, cols, leftDiagonals, rightDiagonals);

                
                board.remove(board.size() - 1);
                cols[col] = false;
                leftDiagonals[leftDiagIdx] = false;
                rightDiagonals[rightDiagIdx] = false;
            }
        }
    }
}
