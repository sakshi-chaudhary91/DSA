class Solution {
     public ArrayList<String> ratInMaze(int[][] maze) {
         ArrayList<String> result = new ArrayList<>();
         int n = maze.length;
         if (maze[0][0] == 0 || maze[n - 1][n - 1] == 0) {
             return result;
         }

         boolean[][] visited = new boolean[n][n];
         solve(0, 0, maze, n, "", result, visited);
         Collections.sort(result); 
         return result;
     }

     private void solve(int row, int col, int[][] maze, int n, String path, 
                        ArrayList<String> result, boolean[][] visited) {
         if (row == n - 1 && col == n - 1) {
             result.add(path);
             return;
         }
         visited[row][col] = true;
         int[] dRow = {1, 0, 0, -1};
         int[] dCol = {0, -1, 1, 0};
         char[] dir = {'D', 'L', 'R', 'U'};

         for (int i = 0; i < 4; i++) {
             int nextRow = row + dRow[i];
             int nextCol = col + dCol[i];
             if (isValid(nextRow, nextCol, maze, n, visited)) {
                 solve(nextRow, nextCol, maze, n, path + dir[i], result, visited);
             }
         }
         visited[row][col] = false;
     }

     private boolean isValid(int row, int col, int[][] maze, int n, boolean[][] visited) {
         return row >= 0 && row < n && col >= 0 && col < n 
                && maze[row][col] == 1 && !visited[row][col];
     }
 }
