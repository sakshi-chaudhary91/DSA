class Solution {
    private static final int[] dRow = {-2, -1, 1, 2, 2, 1, -1, -2};
    private static final int[] dCol = {1, 2, 2, 1, -1, -2, -2, -1};

    public ArrayList<ArrayList<Integer>> knightTour(int n) {
        int[][] board = new int[n][n];
        for (int[] row : board) {
            Arrays.fill(row, -1);
        }

        
        board[0][0] = 0;

        if (!solve(0, 0, 1, board, n)) {
            return new ArrayList<>(); 
        }
        ArrayList<ArrayList<Integer>> result = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            ArrayList<Integer> rowList = new ArrayList<>();
            for (int j = 0; j < n; j++) {
                rowList.add(board[i][j]);
            }
            result.add(rowList);
        }
        return result;
    }

    private boolean solve(int row, int col, int moveNum, int[][] board, int n) {
        if (moveNum == n * n) {
            return true;
        }
        ArrayList<int[]> nextMoves = getNextMoves(row, col, board, n);

        for (int[] move : nextMoves) {
            int nextRow = move[0];
            int nextCol = move[1];

            board[nextRow][nextCol] = moveNum;

            if (solve(nextRow, nextCol, moveNum + 1, board, n)) {
                return true;
            }
            board[nextRow][nextCol] = -1;
        }

        return false;
    }

    private ArrayList<int[]> getNextMoves(int row, int col, int[][] board, int n) {
        ArrayList<int[]> moves = new ArrayList<>();

        for (int i = 0; i < 8; i++) {
            int nextRow = row + dRow[i];
            int nextCol = col + dCol[i];

            if (isValid(nextRow, nextCol, board, n)) {
                int degree = countOnwardMoves(nextRow, nextCol, board, n);
                moves.add(new int[]{nextRow, nextCol, degree});
            }
        }
        moves.sort(Comparator.comparingInt(a -> a[2]));
        return moves;
    }

    private int countOnwardMoves(int row, int col, int[][] board, int n) {
        int count = 0;
        for (int i = 0; i < 8; i++) {
            int nextRow = row + dRow[i];
            int nextCol = col + dCol[i];
            if (isValid(nextRow, nextCol, board, n)) {
                count++;
            }
        }
        return count;
    }

    private boolean isValid(int row, int col, int[][] board, int n) {
        return row >= 0 && row < n && col >= 0 && col < n && board[row][col] == -1;
    }
}
